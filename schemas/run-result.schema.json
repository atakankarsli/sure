{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sure:run-result:v1",
  "title": "Sure run result v1",
  "description": "Output of `sure --json`. Versioned independently of the binary. `confidence` is the lowest P(supported) across selected checks (undecided checks count as 0); it is null when a provider failed or nothing was checked. Exit codes: operational failures outrank violations, which outrank incompleteness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "gate",
    "exit_code",
    "confidence",
    "snapshot",
    "trust",
    "provider",
    "summary",
    "contracts",
    "checks",
    "errors",
    "unmapped_changes",
    "contract_changes",
    "next_actions",
    "timing"
  ],
  "properties": {
    "schema_version": {
      "const": "sure.run/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "incomplete",
        "failed",
        "no_changes",
        "no_applicable_checks"
      ]
    },
    "gate": {
      "enum": [
        "clear",
        "violated",
        "incomplete",
        "error",
        "not_applicable"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        3,
        10,
        11,
        12,
        13,
        130
      ]
    },
    "confidence": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "percent",
            "probability",
            "basis",
            "undecided"
          ],
          "properties": {
            "percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "probability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "basis": {
              "type": "string"
            },
            "undecided": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "snapshot": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "scope",
            "selection",
            "base_ref",
            "base_commit",
            "head_commit",
            "source_digest",
            "changed_paths",
            "application_executed"
          ],
          "properties": {
            "kind": {
              "enum": [
                "worktree"
              ]
            },
            "scope": {
              "enum": [
                "all",
                "changed",
                "contract"
              ]
            },
            "base_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "base_commit": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
            },
            "head_commit": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
            },
            "source_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "changed_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "application_executed": {
              "const": false
            },
            "selection": {
              "enum": [
                "changed",
                "all",
                "all_no_changes",
                "all_no_base",
                "contract"
              ]
            }
          }
        }
      ]
    },
    "trust": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "contracts_ref",
            "contracts_commit",
            "contract_digest",
            "policy_version",
            "min_probability"
          ],
          "properties": {
            "mode": {
              "enum": [
                "protected",
                "draft",
                "adhoc"
              ]
            },
            "contracts_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "contracts_commit": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
            },
            "contract_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "policy_version": {
              "type": "string"
            },
            "min_probability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "provider": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "transport",
            "endpoint",
            "requested_model",
            "returned_models",
            "mode",
            "prompt_version",
            "probability_source",
            "usage"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "transport": {
              "type": "string"
            },
            "endpoint": {
              "type": "string"
            },
            "requested_model": {
              "type": "string"
            },
            "returned_models": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mode": {
              "enum": [
                "none",
                "live",
                "cache",
                "replay",
                "mixed",
                "fake"
              ]
            },
            "prompt_version": {
              "type": "string"
            },
            "probability_source": {
              "enum": [
                "model_distribution",
                "self_reported"
              ]
            },
            "usage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requests",
                "live_requests",
                "cache_hits",
                "input_tokens",
                "output_tokens",
                "estimated_input_tokens"
              ],
              "properties": {
                "requests": {
                  "type": "integer",
                  "minimum": 0
                },
                "live_requests": {
                  "type": "integer",
                  "minimum": 0
                },
                "cache_hits": {
                  "type": "integer",
                  "minimum": 0
                },
                "input_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "output_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "estimated_input_tokens": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "long_context": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "selected",
        "evaluated",
        "supported",
        "violated",
        "unknown",
        "error",
        "not_checked"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "supported": {
          "type": "integer",
          "minimum": 0
        },
        "violated": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "not_checked": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "unmapped_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contract_changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract_change"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_ms",
        "model_ms",
        "total_ms"
      ],
      "properties": {
        "collection_ms": {
          "type": "integer",
          "minimum": 0
        },
        "model_ms": {
          "type": "integer",
          "minimum": 0
        },
        "total_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "role",
        "sha256",
        "bytes",
        "lines"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F[0-9]{3,}$"
        },
        "path": {
          "type": "string"
        },
        "role": {
          "enum": [
            "scope",
            "context"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "enum": [
            "not_found",
            "excluded",
            "binary",
            "too_large",
            "symlink",
            "not_a_file",
            "unreadable"
          ]
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adhoc",
        "path",
        "evidence",
        "selected",
        "files",
        "missing",
        "skipped",
        "state_bytes",
        "request_bytes",
        "estimated_tokens",
        "decision",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "adhoc": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "evidence": {
          "enum": [
            "code",
            "image"
          ]
        },
        "selected": {
          "type": "boolean"
        },
        "selected_by": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          }
        },
        "state_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "request_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "decision": {
          "type": "string"
        },
        "confidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ]
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "start_line",
        "end_line",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "inspected",
            "model_selected"
          ]
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "inspect_source",
            "supply_context",
            "narrow_scope",
            "provide_visual_evidence",
            "review_contract_change",
            "map_changed_source",
            "recheck"
          ]
        },
        "path": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contract",
        "title",
        "verdict",
        "severity",
        "requirement",
        "reason_code",
        "message",
        "message_origin",
        "analysis_level",
        "confidence",
        "probabilities",
        "probability_source",
        "model_confidence",
        "regression",
        "locations",
        "next_actions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*/[A-Z][A-Z0-9]*-[0-9]+$"
        },
        "contract": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "verdict": {
          "enum": [
            "supported",
            "violated",
            "unknown",
            "error",
            "not_checked"
          ]
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "message_origin": {
          "const": "template"
        },
        "analysis_level": {
          "enum": [
            "text-scoped",
            "syntax",
            "semantic"
          ]
        },
        "confidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ]
        },
        "probabilities": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "supported",
                "violated",
                "unknown"
              ],
              "properties": {
                "supported": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "violated": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "unknown": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          ]
        },
        "probability_source": {
          "enum": [
            null,
            "model_distribution",
            "self_reported"
          ]
        },
        "model_confidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ]
        },
        "regression": {
          "enum": [
            "introduced",
            "preexisting",
            "unknown",
            "not_assessed"
          ]
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "next_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "contract": {
          "type": "string"
        },
        "check_id": {
          "type": "string"
        }
      }
    },
    "contract_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "detail"
      ],
      "properties": {
        "kind": {
          "enum": [
            "config_changed",
            "config_invalid",
            "contract_added",
            "contract_removed",
            "contract_invalid",
            "contract_changed",
            "check_added",
            "check_removed",
            "check_changed"
          ]
        },
        "contract": {
          "type": "string"
        },
        "check": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
