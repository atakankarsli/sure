{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sure:run-result:v1",
  "title": "Sure run result \u2014 proposed v1",
  "description": "Additional semantic validation must check probability sums, ordered line ranges, coverage equations and exit precedence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "gate",
    "exit_code",
    "snapshot",
    "trust",
    "provider",
    "summary",
    "checks",
    "errors",
    "unmapped_changes",
    "contract_changes"
  ],
  "properties": {
    "schema_version": {
      "const": "sure.run/v1"
    },
    "example_only": {
      "type": "boolean"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "incomplete",
        "failed",
        "no_changes",
        "no_applicable_checks"
      ]
    },
    "gate": {
      "enum": [
        "clear",
        "violated",
        "incomplete",
        "error",
        "not_applicable"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        3,
        10,
        11,
        12,
        13,
        130
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "base_ref",
        "source_digest",
        "scope",
        "application_executed"
      ],
      "properties": {
        "kind": {
          "enum": [
            "worktree",
            "commit",
            "index"
          ]
        },
        "base_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scope": {
          "enum": [
            "all",
            "changed",
            "contract"
          ]
        },
        "application_executed": {
          "const": false
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "contracts_ref",
        "contract_digest",
        "policy_version"
      ],
      "properties": {
        "mode": {
          "enum": [
            "protected",
            "draft"
          ]
        },
        "contracts_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "contract_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_version": {
          "type": "string"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "requested_model",
        "returned_model",
        "mode",
        "prompt_version",
        "usage"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "requested_model": {
          "type": "string"
        },
        "returned_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "enum": [
            "live",
            "cache",
            "replay",
            "mixed",
            "fake"
          ]
        },
        "prompt_version": {
          "type": "string"
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "input_tokens",
            "output_tokens",
            "cache_hits"
          ],
          "properties": {
            "requests": {
              "type": "integer",
              "minimum": 0
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cache_hits": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "selected",
        "evaluated",
        "supported",
        "violated",
        "unknown",
        "error",
        "not_checked"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "supported": {
          "type": "integer",
          "minimum": 0
        },
        "violated": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "not_checked": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "unmapped_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contract_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "start_line",
        "end_line",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "inspected",
            "model_selected"
          ]
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "inspect_source",
            "supply_context",
            "provide_visual_evidence",
            "review_contract_change",
            "recheck"
          ]
        },
        "path": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "verdict",
        "severity",
        "requirement",
        "reason_code",
        "message",
        "message_origin",
        "analysis_level",
        "locations",
        "next_actions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "enum": [
            "supported",
            "violated",
            "unknown",
            "error",
            "not_checked"
          ]
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "message_origin": {
          "const": "template"
        },
        "analysis_level": {
          "enum": [
            "text-scoped",
            "syntax",
            "semantic"
          ]
        },
        "probabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported",
            "violated",
            "unknown"
          ],
          "properties": {
            "supported": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "violated": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "unknown": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "model_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "next_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "check_id": {
          "type": "string"
        }
      }
    }
  }
}
